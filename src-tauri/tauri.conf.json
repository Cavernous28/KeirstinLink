{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeirstinLink",
  "version": "0.2.6",
  "identifier": "com.cbaxt.keirstinlink",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KeirstinLink",
        "width": 1150,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "both",
        "startMenuFolder": "KeirstinLink"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/keirstinlink_backend.exe": "keirstinlink_backend.exe"
    }
  }
}