# KeirstinLink environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.

# Server binding
KL_HOST=0.0.0.0
KL_PORT=3710

# Data / versions
KL_DATA_DIR=./data
KL_MAX_VERSIONS=3

# Discovery
KL_UDP_PORT=37100
KL_MDNS_NAME=KeirstinLink

# Pre-shared key for bridge authentication (future use)
KL_BRIDGE_PSK=change-me-to-a-long-random-string
