# KeirstinLink environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.

# Master host / bridge endpoint
KL_MASTER_HOST=localhost
KL_MASTER_PORT=7788

# Pre-shared key for bridge authentication
KL_BRIDGE_PSK=change-me-to-a-long-random-string

# Hermes CLI path (only needed if launching Hermes directly)
HERMES_BIN=hermes

# API keys (kept here only for the master; never sent to slaves)
# OPENROUTER_API_KEY=...
# ANTHROPIC_API_KEY=...
